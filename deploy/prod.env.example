# 复制到 /etc/dataforge/dataforge.env，替换所有 CHANGE_ME，并执行 chmod 600。
COMPOSE_PROJECT_NAME=dataforge
DATAFORGE_IMAGE_TAG=local
PUBLIC_PORT=8080
# 登录会话闲置上限及浏览器 Cookie 有效期；使用 s/m/h/d，例如 12h、7d。
DATAFORGE_SESSION_TIMEOUT=7d
# 内部执行服务独立密钥，24～128位字母、数字、下划线或连字符；留空时自动生成。
DATAFORGE_EXECUTION_SECRET=
# 2核2GB服务器建议保持1，增大前应评估每个沙箱最多1GB内存。
DATAFORGE_GENERATION_CONCURRENCY=1
# 多个任务同时执行时，也要相应增大执行服务的临时空间和内存上限，详见部署文档。
DATAFORGE_RUNNER_TMP_SIZE=192m
DATAFORGE_RUNNER_MEMORY_LIMIT=256m
DATAFORGE_TEMP_RETENTION_DAYS=30
DATAFORGE_TEMP_CLEANUP_ENABLED=false

# build：在服务器本地构建；registry：从 GHCR 等私有仓库拉取 Git 提交对应的成品镜像。
DATAFORGE_IMAGE_SOURCE=build
# registry 模式必填，必须以 / 结尾，例如：
# ghcr.io/shendeguilai/
DATAFORGE_REGISTRY_PREFIX=
# registry 模式下应指向已经同步到私有仓库的 PostgreSQL 镜像。
DATAFORGE_POSTGRES_IMAGE=postgres:17.10-bookworm

POSTGRES_DB=dataforge
POSTGRES_USER=dataforge
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_POOL_SIZE=10

DATAFORGE_POSTGRES_DIR=/srv/dataforge/postgres
DATAFORGE_RUNTIME_DIR_HOST=/srv/dataforge/runtime
DATAFORGE_BACKUP_DIR=/srv/dataforge/backups
DATAFORGE_MIGRATION_DIR=/srv/dataforge/migration

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
INVITE_CODE=CHANGE_ME_INVITE_CODE
DATAFORGE_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS

DAILY_GENERATION_LIMIT=30
DATAFORGE_PROCESS_STACK_MB=256

AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-v4-pro
ATCODER_COOKIE=

# CSP Paper Studio 默认使用 Compose 内网服务，无特殊网络拓扑时无需修改。
CSP_STUDIO_BASE_URL=http://csp-studio:8765

# 仅首次 H2 迁移使用。若旧环境从未设置过该变量，旧默认值是：
# change-this-secret-before-production
LEGACY_DATAFORGE_SECRET=
LEGACY_ALLOW_MISSING_ARTIFACTS=false
# CSP 复赛评测：启用 csp-sim profile 前配置至少24字符的独立随机密钥。
CSP_SIM_WORKER_SECRET=
CSP_SIM_ENABLED=false
# 2核2GB主机先设为1，并在服务器上验证内存余量与真实评测
CSP_SIM_CONCURRENCY=2
# 小内存主机可限制网站内存；0 表示沿用不限制，选用 768m 时建议配合以下 Java 堆设置
DATAFORGE_APP_MEMORY_LIMIT=0
DATAFORGE_JAVA_OPTIONS=''
